CREATE PROCEDURE {databaseOwner}[{objectQualifier}BCCForms_SetFieldOrder]
	  @UserDefinedFieldId   INT,
      @FieldOrder   INT
    as 
	DECLARE @id INT
    DECLARE @Pos INT
    SET @id =  (SELECT        UDF.UserDefinedFieldId
                FROM          {databaseOwner}[{objectQualifier}BCCForms_Fields] AS UDF INNER JOIN
                                          {databaseOwner}[{objectQualifier}BCCForms_Fields] AS ModuleFields ON UDF.ModuleId = ModuleFields.ModuleId
                WHERE        (UDF.FieldOrder = @FieldOrder) AND (ModuleFields.UserDefinedFieldId = @UserDefinedFieldId))
    SET @Pos = (SELECT FieldOrder FROM {databaseOwner}[{objectQualifier}BCCForms_Fields] WHERE UserDefinedFieldId = @UserDefinedFieldId)

    UPDATE {databaseOwner}[{objectQualifier}BCCForms_Fields] SET FieldOrder = -1    WHERE UserDefinedFieldId = @id
    UPDATE {databaseOwner}[{objectQualifier}BCCForms_Fields] SET FieldOrder = @FieldOrder    WHERE UserDefinedFieldId = @UserDefinedFieldId
    UPDATE {databaseOwner}[{objectQualifier}BCCForms_Fields] SET FieldOrder = @Pos WHERE UserDefinedFieldId = @Id
GO

