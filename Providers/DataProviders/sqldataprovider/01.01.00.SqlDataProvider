DECLARE @Modules TABLE (ModuleID INT NOT NULL PRIMARY KEY)
INSERT INTO @Modules (ModuleID)
SELECT m.ModuleID
FROM {databaseOwner}[{objectQualifier}Modules] m
    INNER JOIN {databaseOwner}[{objectQualifier}ModuleDefinitions] md ON md.ModuleDefID = m.ModuleDefID
    INNER JOIN {databaseOwner}[{objectQualifier}DesktopModules] dm ON dm.DesktopModuleID = md.DesktopModuleID
WHERE dm.ModuleName = N'BCCForms'

UPDATE s SET s.SettingName = map.NewName
FROM {databaseOwner}[{objectQualifier}ModuleSettings] s
    INNER JOIN @Map map ON map.OldName = s.SettingName
    INNER JOIN @Modules mods ON mods.ModuleID = s.ModuleID
WHERE NOT EXISTS (SELECT 1 FROM {databaseOwner}[{objectQualifier}ModuleSettings] x
                  WHERE x.ModuleID = s.ModuleID AND x.SettingName = map.NewName)

UPDATE s SET s.SettingName = map.NewName
FROM {databaseOwner}[{objectQualifier}TabModuleSettings] s
    INNER JOIN @Map map ON map.OldName = s.SettingName
    INNER JOIN {databaseOwner}[{objectQualifier}TabModules] tm ON tm.TabModuleID = s.TabModuleID
    INNER JOIN @Modules mods ON mods.ModuleID = tm.ModuleID
WHERE NOT EXISTS (SELECT 1 FROM {databaseOwner}[{objectQualifier}TabModuleSettings] x
                  WHERE x.TabModuleID = s.TabModuleID AND x.SettingName = map.NewName)
GO
