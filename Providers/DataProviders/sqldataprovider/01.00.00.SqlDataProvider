CREATE PROCEDURE {databaseOwner}[{objectQualifier}BCCForms_SwapFieldOrder]
@FirstUserDefinedFieldId   INT,
@SecndUserDefinedFieldId   INT
AS
DECLARE @Pos1 INT
DECLARE @Pos2 INT
SET @Pos1 = (SELECT FieldOrder FROM {databaseOwner}{objectQualifier}BCCForms_Fields WHERE UserDefinedFieldId = @FirstUserDefinedFieldId)
SET @Pos2 = (SELECT FieldOrder FROM {databaseOwner}{objectQualifier}BCCForms_Fields WHERE UserDefinedFieldId = @SecndUserDefinedFieldId)

UPDATE {objectQualifier}BCCForms_Fields SET FieldOrder = -1    WHERE UserDefinedFieldId = @SecndUserDefinedFieldId
UPDATE {objectQualifier}BCCForms_Fields SET FieldOrder = @Pos2 WHERE UserDefinedFieldId = @FirstUserDefinedFieldId
UPDATE {objectQualifier}BCCForms_Fields SET FieldOrder = @Pos1 WHERE UserDefinedFieldId = @SecndUserDefinedFieldId
GO

